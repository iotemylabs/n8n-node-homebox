{
	"name": "@iotemy/n8n-nodes-homebox",
	"version": "0.1.0",
	"description": "n8n community node for Homebox (sysadminsmedia fork) — home inventory items, locations, tags, attachments, maintenance and warranty tracking",
	"license": "MIT",
	"homepage": "https://github.com/iotemylabs/n8n-node-homebox",
	"keywords": [
		"n8n-community-node-package",
		"homebox",
		"inventory",
		"home-inventory",
		"self-hosted"
	],
	"author": {
		"name": "IoTemy Labs",
		"email": "brett@iotemylabs.com"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/iotemylabs/n8n-node-homebox.git"
	},
	"engines": {
		"node": ">=22"
	},
	"scripts": {
		"build": "n8n-node build",
		"build:watch": "tsc --watch",
		"dev": "n8n-node dev",
		"lint": "n8n-node lint",
		"lint:fix": "n8n-node lint --fix",
		"release": "n8n-node release",
		"prepublishOnly": "n8n-node prerelease"
	},
	"files": [
		"dist"
	],
	"publishConfig": {
		"access": "public"
	},
	"n8n": {
		"n8nNodesApiVersion": 1,
		"strict": true,
		"credentials": [
			"dist/credentials/HomeboxApi.credentials.js"
		],
		"nodes": [
			"dist/nodes/Homebox/Homebox.node.js",
			"dist/nodes/Homebox/HomeboxTrigger.node.js"
		]
	},
	"devDependencies": {
		"@n8n/node-cli": "*",
		"eslint": "9.39.4",
		"prettier": "3.8.3",
		"release-it": "21.0.2",
		"typescript": "5.9.3"
	},
	"peerDependencies": {
		"n8n-workflow": "*"
	}
}
